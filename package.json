{
  "name": "svelte-copyright",
  "description": "A Svelte component to format and display a copyright notice.",
  "version": "2.1.0",
  "author": {
    "name": "himynameisdave",
    "email": "d@velunny.com",
    "url": "https://himynameisdave.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "svelte-kit sync && eslint . --ext .js,.ts,.svelte",
    "lint:fix": "svelte-kit sync && eslint . --ext .js,.ts,.svelte --fix",
    "test": "npm run test:integration && npm run test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "release": "npm run package && np --no-yarn"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "engines": {
    "node": ">= 20"
  },
  "lint-staged": {
    "*.ts": "eslint ./ --fix --quiet",
    "*.svelte": "eslint ./ --fix --quiet"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-himynameisdave": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-svelte": "^2.46.1",
    "eslint-plugin-unicorn": "^51.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "less": "^4.8.0",
    "lint-staged": "^17.2.0",
    "np": "^12.0.0",
    "publint": "^0.3.22",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^0.43.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "svelte",
    "component",
    "copyright",
    "notice",
    "footer",
    "license",
    "attribution",
    "website",
    "web-design",
    "frontend",
    "legal",
    "year",
    "svelte-components",
    "license-display",
    "attribution-tool",
    "web-component",
    "copy-protection",
    "legal-footer"
  ],
  "private": false,
  "license": "MIT"
}
